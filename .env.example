# Copy to .env and adjust. Never commit .env.

# Postgres connection for the app (docker compose starts this on port 5433).
DATABASE_URL="postgresql://csp:csp@localhost:5433/csp_dev"

# Separate database used by the Playwright end-to-end tests (wiped on every run).
TEST_DATABASE_URL="postgresql://csp:csp@localhost:5433/csp_test"

# Secret used to sign session cookies. Generate one with: openssl rand -base64 32
AUTH_SECRET="replace-me"

# Public base URL of the app, used in password reset links.
APP_URL="http://localhost:3000"

# Email for password resets. Leave SMTP_HOST empty to use demo mode:
# reset emails are stored and shown at /dev/mailbox instead of being sent.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Career Switch Portal <no-reply@example.com>"

# Passwords for the seeded demo accounts (learner@demo.local, admin@demo.local).
# Defaults are documented in the README; change them for any shared environment.
DEMO_LEARNER_PASSWORD="LearnDemo2026!"
DEMO_ADMIN_PASSWORD="AdminDemo2026!"

# The demo mailbox page (/dev/mailbox) shows every reset email, so it is turned off in
# production builds. Set to "true" only for a private demo server.
ALLOW_DEMO_MAILBOX=""
