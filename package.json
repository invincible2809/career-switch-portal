{
  "name": "career-switch-portal",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:up": "docker compose up -d --wait db",
    "db:down": "docker compose down",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset --force",
    "content:check": "tsx scripts/check-content.ts",
    "postinstall": "prisma generate && node scripts/copy-sql-wasm.mjs"
  },
  "dependencies": {
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@node-rs/argon2": "2.2.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@react-pdf/renderer": "^4.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gray-matter": "^4.0.3",
    "hast-util-sanitize": "^5.0.2",
    "lucide-react": "^1.71.0",
    "next": "16.4.6",
    "next-auth": "5.0.0-beta.32",
    "nodemailer": "^8.0.11",
    "pg": "^8.23.1",
    "prisma": "7.10.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-directive": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "server-only": "^0.0.1",
    "sql.js": "^1.16.0",
    "tailwind-merge": "^3.7.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.2.0",
    "yaml": "^2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sql.js": "^1.4.11",
    "dotenv": "^18.0.10",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "4.1.4"
  }
}
